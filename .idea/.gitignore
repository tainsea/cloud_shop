# 默认忽略的文件
/shelf/
/workspace.xml
# 基于编辑器的 HTTP 客户端请求
/httpRequests/
# 已忽略包含查询文件的默认文件夹
/queries/
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml
# 编译输出目录
target/
!.mvn/wrapper/maven-wrapper.jar
build/

# IDE 配置文件
.idea/
*.iml
*.iws
.vscode/

# 本地环境/敏感信息文件 (非常重要!)
*.properties
*.yml
*.yaml
# 如果你想保留配置文件的模板，可以这样写：
# !application-example.yml
# !application-example.properties

# 日志文件
*.log
logs/

# 操作系统文件
.DS_Store
Thumbs.db